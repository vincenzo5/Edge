{
  "name": "tv-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "setup": "npm ci",
    "check": "npm run lint:instructions && npm run lint:harness-retention && npm run lint:roadmap-status && npm run lint:efficiency-ledger && npm run lint:data-state-contracts && npm run check:packages && npm test -- --run && npm run build",
    "check:packages": "npm run lint:package-boundaries && npm run lint:app-lib-boundaries && npm run lint:chart-shims && npm run typecheck:packages && npm run check:examples",
    "check:examples": "npm run build:packages && npm run check -w @edge/example-chart-core-basic && npm run check -w @edge/example-chart-react-basic && npm run check -w @edge/example-chart-plugins-basic && npm run check -w @edge/example-ai-tools-chart-basic && npm run check -w @edge/example-chart-data-source-basic && npm run check -w @edge/example-chart-perf-harness && npm run check -w @edge/example-indicator-runtime-spike",
    "check:startup": "npm run lint:instructions && npm test -- --run src/test/startup.test.ts src/app/components/chartContextMenu.test.ts src/app/components/chartCopyMenu.test.ts",
    "lint:package-boundaries": "npx tsx scripts/validate-package-boundaries.mts",
    "lint:app-lib-boundaries": "npx tsx scripts/validate-app-lib-boundaries.mts",
    "lint:chart-shims": "npx tsx scripts/validate-chart-shims.mts",
    "lint:data-state-contracts": "npx tsx scripts/validate-data-state-contracts.mts",
    "typecheck:packages": "npm run typecheck -w @edge/chart-core && npm run typecheck -w @edge/chart-react && npm run typecheck -w @edge/indicator-runtime && npm run typecheck -w @edge/ai-tools-core && npm run typecheck -w @edge/ai-tools-chart",
    "build:packages": "npm run build -w @edge/chart-core && npm run build -w @edge/indicator-runtime && npm run build -w @edge/ai-tools-core && npm run build -w @edge/ai-tools-chart && npm run build -w @edge/chart-react",
    "build:example": "npm run build:packages && npm run check:examples",
    "dev": "bash scripts/dev-with-db.sh",
    "dev:lite": "TWS_ENABLED=false next dev -H 127.0.0.1 -p 3003",
    "dev:with-db": "npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:instructions": "npx tsx scripts/validate-agent-instructions.mts",
    "lint:harness-retention": "npx tsx scripts/validate-harness-retention.mts",
    "lint:roadmap-status": "npx tsx scripts/check-roadmap-status.mts",
    "lint:efficiency-ledger": "npx tsx scripts/lint-efficiency-ledger.mts",
    "test": "vitest",
    "mcp:edge": "npx tsx scripts/edge-mcp-server.mts",
    "db:up": "docker compose up -d postgres",
    "db:wait": "npx tsx scripts/wait-for-postgres.mts",
    "db:down": "docker compose down",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose stop redis",
    "local:infra:up": "npx tsx scripts/local-data-infrastructure.mts up",
    "local:infra:provision": "npx tsx scripts/local-data-infrastructure.mts provision",
    "local:infra:verify": "npx tsx scripts/local-data-infrastructure.mts verify",
    "local:deploy:preflight": "npx tsx scripts/validate-local-deploy.mts preflight",
    "local:deploy:status": "npx tsx scripts/validate-local-deploy.mts status",
    "local:prod:setup": "bash scripts/local-prod.sh setup",
    "local:prod:preflight": "bash scripts/local-prod.sh preflight",
    "local:prod:migrate": "bash scripts/local-prod.sh migrate",
    "local:prod:build": "bash scripts/local-prod.sh build",
    "local:prod:start": "bash scripts/local-prod.sh start",
    "local:prod:stop": "bash scripts/local-prod.sh stop",
    "local:prod:status": "bash scripts/local-prod.sh status",
    "local:prod:logs": "bash scripts/local-prod.sh logs",
    "local:prod:service:install": "bash scripts/install-local-prod-service.sh install",
    "local:prod:service:uninstall": "bash scripts/install-local-prod-service.sh uninstall",
    "local:prod:service:start": "bash scripts/install-local-prod-service.sh start",
    "local:prod:service:stop": "bash scripts/install-local-prod-service.sh stop",
    "local:prod:service:restart": "bash scripts/install-local-prod-service.sh restart",
    "local:prod:service:status": "bash scripts/install-local-prod-service.sh status",
    "local:prod:service:logs": "bash scripts/install-local-prod-service.sh logs",
    "local:prod:deploy": "bash scripts/deploy-local-prod.sh deploy",
    "local:prod:rollback": "bash scripts/deploy-local-prod.sh rollback",
    "local:prod:verify": "npx tsx scripts/verify-local-environments.mts",
    "local:prod:container:build": "bash scripts/local-prod-container.sh build",
    "local:prod:container:migrate": "bash scripts/local-prod-container.sh migrate",
    "local:prod:container:start": "bash scripts/local-prod-container.sh start",
    "local:prod:container:stop": "bash scripts/local-prod-container.sh stop",
    "local:prod:container:restart": "bash scripts/local-prod-container.sh restart",
    "local:prod:container:status": "bash scripts/local-prod-container.sh status",
    "local:prod:container:logs": "bash scripts/local-prod-container.sh logs",
    "local:prod:container:inspect": "bash scripts/local-prod-container.sh inspect",
    "local:prod:container:deploy": "bash scripts/deploy-local-prod-container.sh deploy",
    "local:prod:container:rollback": "bash scripts/deploy-local-prod-container.sh rollback",
    "local:https:install": "bash scripts/local-https.sh install-certs",
    "local:https:start": "bash scripts/local-https.sh start",
    "local:https:stop": "bash scripts/local-https.sh stop",
    "local:https:status": "bash scripts/local-https.sh status",
    "local:https:uninstall": "bash scripts/local-https.sh uninstall",
    "local:https:service:install": "bash scripts/local-https.sh service-install",
    "local:https:service:uninstall": "bash scripts/local-https.sh service-uninstall",
    "local:https:service:status": "bash scripts/local-https.sh service-status",
    "image:build": "npx tsx scripts/build-app-image.mts build",
    "image:inspect": "npx tsx scripts/build-app-image.mts inspect",
    "image:migrate:build": "npx tsx scripts/build-app-image.mts migrate-image",
    "compose:validate": "npx tsx scripts/compose-app-service.mts inspect",
    "db:migrate": "npx tsx scripts/db-migrate.mts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "ib:gateway:up": "docker compose --project-directory services/ib-gateway -f services/ib-gateway/docker-compose.yml up -d",
    "ib:gateway:down": "docker compose --project-directory services/ib-gateway -f services/ib-gateway/docker-compose.yml down",
    "ibkr:setup": "bash scripts/ibkr-setup-gateway.sh",
    "ibkr:gateway": "bash scripts/ibkr-gateway.sh",
    "ibkr:probe": "npx tsx scripts/ibkr-probe.mts",
    "ibkr:options-probe": "npx tsx scripts/ibkr-options-probe.mts",
    "tws:sidecar-setup": "bash scripts/tws-sidecar-setup.sh",
    "tws:sidecar": "bash scripts/tws-sidecar.sh",
    "tws:sidecar:test": "cd services/tws-sidecar && ../../.tools/tws-sidecar-venv/bin/python -m unittest test_main -v",
    "tws:probe": "npx tsx scripts/tws-probe.mts",
    "tws:options-probe": "npx tsx scripts/tws-options-probe.mts",
    "fmp:gap-probe": "npx tsx scripts/fmp-gap-probe.mts",
    "events:coverage-probe": "npx tsx scripts/events-coverage-probe.mts",
    "perf:chart": "npx tsx scripts/run-chart-perf.mts",
    "ux:baseline": "npx tsx scripts/run-ux-baseline.mts",
    "perf:market-data": "npx tsx scripts/run-market-data-perf.mts",
    "perf:memory": "npx tsx --import ./scripts/register-server-only-stub.mts scripts/run-memory-baseline.mts",
    "report:data-reliability": "npx tsx scripts/report-data-reliability.mts",
    "report:local-errors": "npx tsx scripts/report-local-errors.mts",
    "report:memory": "npx tsx scripts/report-memory.mts",
    "report:trading-audit": "npx tsx --import ./scripts/register-server-only-stub.mts scripts/report-trading-audit.mts",
    "report:production-errors": "npx tsx --import ./scripts/register-server-only-stub.mts scripts/report-production-errors.mts",
    "watch:readyz": "npx tsx scripts/watch-readyz.mts",
    "smoke:data-providers": "npx tsx scripts/run-data-provider-smoke.mts",
    "pattern-library:seed": "npx tsx scripts/pattern-library-seed.mts",
    "pattern-library:bakeoff": "npx tsx scripts/pattern-library-bakeoff.mts",
    "pattern-library:stress": "npx tsx scripts/pattern-library-stress.mts",
    "docs:auto-update": "npx tsx scripts/update-docs-for-diff.mts",
    "harness:closeout": "npx tsx scripts/harness-closeout.mts",
    "harness:activate": "npx tsx scripts/harness-activate.mts",
    "efficiency:start": "npx tsx scripts/efficiency-ledger.mts start",
    "efficiency:pause": "npx tsx scripts/efficiency-ledger.mts pause",
    "efficiency:resume": "npx tsx scripts/efficiency-ledger.mts resume",
    "efficiency:switch": "npx tsx scripts/efficiency-ledger.mts switch",
    "efficiency:list": "npx tsx scripts/efficiency-ledger.mts list",
    "efficiency:attach": "npx tsx scripts/efficiency-ledger.mts attach",
    "efficiency:import-usage": "npx tsx scripts/efficiency-ledger.mts import-usage",
    "efficiency:reconcile": "npx tsx scripts/efficiency-ledger.mts reconcile",
    "efficiency:status": "npx tsx scripts/efficiency-ledger.mts status",
    "efficiency:backfill": "npx tsx scripts/efficiency-backfill.mts",
    "status:prune": "npx tsx scripts/harness-archive.mts",
    "roadmaps:status-check": "npx tsx scripts/check-roadmap-status.mts",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.22",
    "@edge/ai-tools-chart": "*",
    "@edge/ai-tools-core": "*",
    "@edge/chart-core": "*",
    "@edge/chart-react": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-virtual": "^3.14.8",
    "drizzle-orm": "^0.45.2",
    "html-to-image": "^1.11.13",
    "ioredis": "^5.11.1",
    "monaco-editor": "^0.56.0",
    "next": "^16.2.11",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "ws": "^8.21.0",
    "yahoo-finance2": "^3.15.3",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.9"
  }
}
