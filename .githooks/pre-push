#!/bin/sh
# Local CI only — no GitHub Actions.
# Install: npm run hooks:install
#
# Default: npm run ci:local (check:startup)
# Skip CI:   EDGE_SKIP_LOCAL_CI=1 git push
# Docs hook (Cursor API, opt-in): EDGE_DOCS_HOOK=1 git push
# Skip docs when enabled: EDGE_SKIP_DOCS_HOOK=1 git push

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

if [ "$EDGE_SKIP_LOCAL_CI" != "1" ]; then
  echo "pre-push: npm run ci:local"
  npm run ci:local || exit 1
fi

if [ "$EDGE_DOCS_HOOK" = "1" ] && [ "$EDGE_SKIP_DOCS_HOOK" != "1" ]; then
  echo "pre-push: docs:auto-update"
  exec npx tsx scripts/update-docs-for-diff.mts --pre-push
fi

exit 0
