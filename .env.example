# Development profile — copy to .env.local in the active checkout.
# Phase 1 provisions edge_dev and edge_prod via: npm run local:infra:provision
EDGE_APP_HOST=127.0.0.1
EDGE_APP_PORT=3003
DATABASE_URL=postgres://tvai:tvai@localhost:5432/edge_dev
EDGE_MARKET_DATA_CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379
EDGE_REQUIRE_REDIS=0
EDGE_CACHE_ENV=dev

# Production profile — legacy worktree/LaunchAgent path retired after Phase 5.
# Use container production only: copy keys to .edge/local-prod/production.env in
# the development checkout (chmod 600). Never commit real values.
# Preflight: npm run local:prod:preflight (container contract)
# Lifecycle: npm run local:prod:container:{build,migrate,start,stop,restart,status,logs,inspect}
# Cutover: npm run local:prod:service:uninstall if LaunchAgent was installed.
#
# Container successor profile:
# DATABASE_URL=postgres://tvai:replace-with-local-db-password@postgres:5432/edge_prod
# REDIS_URL=redis://redis:6379
# TWS_ENABLED=false
# When TWS is enabled: TWS_MANAGED=external only;
# TWS_SIDECAR_URL=http://host.docker.internal:8765 and TWS_SIDECAR_SECRET required
# (same secret as services/ib-gateway/.env and .env.local — start stack with npm run ib:gateway:up).
# EDGE_TRADING_ENVIRONMENT_LOCK=live
# Phase 1 image build: allowlisted NEXT_PUBLIC_* values are passed via docker
# build-arg only; runtime secrets stay in production.env and never enter image layers.
# Phase 2 Compose: export EDGE_APP_IMAGE=edge-app:<full-git-sha> before starting
# app-prod; migrate with:
# docker compose --profile migrate run --rm app-prod-migrate
# Start app-prod with:
# EDGE_APP_IMAGE=edge-app:<full-git-sha> docker compose --profile prod up -d --wait app-prod
# Phase 3 lifecycle CLI (preferred operator surface):
# npm run local:prod:container:{build,migrate,start,stop,restart,status,logs,inspect}
# Example: npm run local:prod:container:start -- --image edge-app:<full-git-sha>
# Phase 4 image-based promotion and rollback:
# npm run local:prod:container:deploy -- --revision <sha|tag>
# npm run local:prod:container:rollback
# Phase 5 concurrent-operations proof:
# npm run local:prod:verify -- all
# npm run local:prod:verify -- --allow-disruptive <scenario>
# Deploy state (SHA + digest) lives in .edge/local-prod/deploy-revisions.json
# Legacy local:prod:{setup,build,start,deploy,rollback} and service install/start refuse after Phase 5.
# EDGE_APP_HOST=127.0.0.1
# EDGE_APP_PORT=3000
# DATABASE_URL=postgres://tvai:replace-with-local-db-password@localhost:5432/edge_prod
# EDGE_MARKET_DATA_CACHE_BACKEND=redis
# REDIS_URL=redis://localhost:6379
# EDGE_REQUIRE_REDIS=1
# EDGE_CACHE_ENV=prod
# EDGE_AUTH_SECRET=replace-with-a-distinct-long-random-secret
# EDGE_API_AUTH_MODE=key
# EDGE_API_KEY=replace-with-a-long-random-api-key
# EDGE_ALLOW_OPEN_DEV_SESSION=1
# EDGE_READYZ_URL=http://127.0.0.1:3000/readyz
# Public app URL for OpenRouter referer and absolute links (optional local HTTPS front door)
# EDGE_PUBLIC_APP_URL=https://edge.local
# See docs/ops/local-https.md for loopback Caddy + mkcert setup.
# TWS_ENABLED=true
# TWS_MANAGED=local

# Shared market-data cache (topology policy → shared-cache-topology-roadmap.md)
# Unit/default CI may use memory. Concurrent local dev/prod uses the Redis
# settings above; production is fail-loud and keys remain environment-prefixed.
# EDGE_MARKET_DATA_CACHE_BACKEND=memory
# Staging/prod (dedicated co-located Redis; AUTH + TLS when provider requires):
# REDIS_URL=redis://:password@redis-host:6379/0
# REDIS_URL=rediss://:password@redis-host:6380/0
# Fail-loud when Redis is mandatory (boot throw if REDIS_URL missing or ping fails):
#   on when EDGE_REQUIRE_REDIS=1 or NODE_ENV=production (set explicitly on staging if not production Node env)
#   off for local dev / default CI (warn + memory fallback)
# Deploy env segment for Redis key isolation when staging/prod share one Redis (overrides NODE_ENV mapping):
# EDGE_CACHE_ENV=staging

# Required for signed placeholder auth when persistence is enabled
# Rotating this value invalidates all signed session cookies (global logout).
# Session cookies include iat/jti and expire after 14 days (server + browser Max-Age).
EDGE_AUTH_SECRET=replace-with-a-long-random-secret

# Optional dev user email for the placeholder auth boundary
EDGE_DEV_USER_EMAIL=dev@localhost

# Local dev only — auto-bootstrap signed dev session when persistence is on (non-production)
EDGE_ALLOW_OPEN_DEV_SESSION=1

# Required outside dev-open for headless cron (GET/POST /api/cron/*)
# EDGE_CRON_SECRET=replace-with-a-local-cron-secret

# Service principal for headless trading mutations when persistence is enabled
# EDGE_TRADING_SERVICE_SECRET=replace-with-a-local-trading-service-secret

# Optional dev session passphrase — when set, cloud sync requires POST /api/auth/dev-session.
# Local container prod must leave this unset (open sync via EDGE_ALLOW_OPEN_DEV_SESSION=1).
# EDGE_DEV_PASSPHRASE=replace-with-a-local-passphrase

# API hardening — local dev uses dev-open; production/LAN deploys must set EDGE_API_KEY
EDGE_API_AUTH_MODE=dev-open
# EDGE_API_KEY=replace-with-a-local-api-key
# EDGE_TRUST_LOCALHOST=true
# Number of trusted reverse-proxy hops before client IP in X-Forwarded-For (default: ignore forwarding headers)
# EDGE_TRUSTED_PROXY_COUNT=1
# EDGE_RATE_LIMIT=1

# In-app AI agent (server-only — never expose to the browser)
# OPENROUTER_API_KEY=replace-with-openrouter-key
# EDGE_AI_DEFAULT_MODEL=x-ai/grok-4.5

# Cursor SDK — optional docs auto-update (opt-in: EDGE_DOCS_HOOK=1 git push after npm run hooks:install)
CURSOR_API_KEY=
# Optional model override for docs automation (default: auto)
CURSOR_DOCS_MODEL=

# Market data providers (optional — Yahoo works without keys for dev)
FRED_API_KEY=
FMP_API_KEY=
MASSIVE_API_KEY=
POLYGON_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_UNIVERSE_LOOKBACK_DAYS=252
MASSIVE_UNIVERSE_MAX_WARM_CALLS=252
SEC_USER_AGENT=EdgeChart/1.0 (contact@example.com)

# IBKR Client Portal Gateway (read-only market data; login via Gateway browser UI)
# Default: https://localhost:5001/v1/api — on macOS, port 5000 is often AirPlay; use 5001 in Gateway conf.yaml.
# IBKR_SSL_VERIFY defaults to true; set false only for local self-signed Gateway certs.
IBKR_ENABLED=false
IBKR_BASE_URL=https://localhost:5001/v1/api
IBKR_SSL_VERIFY=true
IBKR_READ_ONLY=true
IBKR_COMPETE_SESSION=false

# IB Gateway Docker (dual paper+live — see services/ib-gateway/.env.example)
# Copy to services/ib-gateway/.env; start with npm run ib:gateway:up
# TWS_USERID=
# TWS_PASSWORD=
# TWS_USERID_PAPER=
# TWS_PASSWORD_PAPER=
# VNC_SERVER_PASSWORD=
# TRADING_MODE=both
# EXISTING_SESSION_DETECTED_ACTION=primary
# READ_ONLY_API=no

# IB Gateway / TWS API sidecar (read-only market data via local Python sidecar)
# Paper Gateway default port is 4002; live Gateway uses 4001.
TWS_ENABLED=false
TWS_HOST=127.0.0.1
TWS_PORT=4002
TWS_PAPER_PORT=4002
TWS_LIVE_PORT=4001
TWS_CLIENT_ID=77
TWS_PAPER_CLIENT_ID=77
TWS_LIVE_CLIENT_ID=78
TWS_SIDECAR_URL=http://127.0.0.1:8765
TWS_SIDECAR_PORT=8765
# Dual-consumer cutover (Phase 4): Compose owns the sidecar — npm run ib:gateway:up starts
# Gateways + sidecar. Dev uses loopback below; container prod uses host.docker.internal (see production.env block above).
# TWS_SIDECAR_SECRET is required when dev + app-prod share the Compose sidecar (≥32 chars; same value on sidecar + both apps).
# TWS_SIDECAR_SECRET=replace-with-a-local-sidecar-secret-at-least-32-chars-long
# Who manages the sidecar: external only for dual-consumer — apps never spawn/kill Compose sidecar.
# Emergency fallback only: npm run tws:sidecar (stop Compose sidecar first if port 8765 conflicts).
# Compose sidecar env (set in docker-compose.yml): TWS_SIDECAR_BIND=0.0.0.0, TWS_PAPER_HOST=ib-gateway-paper,
# TWS_PAPER_PORT=4004, TWS_LIVE_HOST=ib-gateway-live, TWS_LIVE_PORT=4003 — see docs/roadmaps/persistent-tws-sidecar-roadmap.md
TWS_MANAGED=external
TWS_SIDECAR_TIMEOUT_MS=15000
TWS_CANDLES_TIMEOUT_MS=3000
TWS_QUOTES_TIMEOUT_MS=3000
TWS_OPTIONS_TIMEOUT_MS=15000

# IB account tracking (read-only by default; positions/PnL via TWS sidecar)
# Paper account pin — applied to ib-paper only (not ib-live)
TWS_ACCOUNT_ID=
# Live account pin for ib-live status/summary (defaults to live managedAccounts[0])
# TWS_LIVE_ACCOUNT_ID=U25026894
# Offline demo journal account for dashboard visualization (no IB Gateway required when set)
# EDGE_DEMO_JOURNAL_ACCOUNT_ID=DEMO0001
# Demo journal user — set before first session bootstrap, then clear session cookie
# EDGE_DEV_USER_EMAIL=demo@localhost
# Emergency halt for all trading mutations (preview/submit/modify/cancel)
# EDGE_TRADING_KILL_SWITCH=true
# Process-level paper/live pin when dev (:3003) and container prod (:3000) share one host sidecar
# Development: EDGE_TRADING_ENVIRONMENT_LOCK=paper
# Container production (.edge/local-prod/production.env): EDGE_TRADING_ENVIRONMENT_LOCK=live
# EDGE_TRADING_ENVIRONMENT_LOCK=paper

# Optional: IB Flex Web Service for automatic trading journal history backfill (server-side import)
# Required for portal-trade catch-up when Gateway execution window has rolled past fills.
# IB_FLEX_TOKEN=
# IB_FLEX_QUERY_ID=

# Optional: WebGL2 candle renderer for main-pane OHLC (falls back to Canvas when unavailable)
# NEXT_PUBLIC_WEBGL_CANDLES=1

# Optional: WebGL2 renderer for declarative indicator line/histogram series
# NEXT_PUBLIC_WEBGL_INDICATORS=1

# Optional: server-proxied SSE for live candle/quote updates (default: client polling)
# NEXT_PUBLIC_STREAM_TRANSPORT=server-proxied

# Watchlist live quote stream via /api/stream/quotes (default: on when EventSource available)
# NEXT_PUBLIC_WATCHLIST_STREAM=1

# Observability (production free stack — see src/lib/observability/ARCHITECTURE.md + production-observability-roadmap.md)
# Phase 2: request correlation header name (default x-edge-request-id)
# EDGE_REQUEST_ID_HEADER=x-edge-request-id
# Phase 1: when 1, /readyz pings TWS sidecar /health when TWS_SIDECAR_URL is set
# EDGE_READYZ_REQUIRE_TWS=1
# Phase 3: trading audit Postgres retention (days or row cap — Phase 3 sets default)
# EDGE_AUDIT_RETENTION_DAYS=90
# Phase 4: production error sink Postgres retention
# EDGE_ERROR_RETENTION_DAYS=30
# Phase 5: free alerts — external /readyz watcher (cron or npm run watch:readyz -- --loop)
# Development watcher example; production profile above must target port 3000.
# EDGE_READYZ_URL=http://127.0.0.1:3003/readyz
# EDGE_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# EDGE_READYZ_ALERT_FAILURES=3
# EDGE_ALERT_HOST=prod-edge-1

# Market data latency telemetry in dev (panel + console export)
# NEXT_PUBLIC_MARKET_DATA_TELEMETRY=1

# Include server phase metadata in API responses and perf baselines
# MARKET_DATA_PERF=1
