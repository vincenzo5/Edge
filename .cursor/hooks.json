{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/efficiency-prompt-log.mjs",
        "failClosed": false
      }
    ],
    "sessionStart": [
      {
        "command": ".cursor/hooks/efficiency-session-start.mjs",
        "failClosed": false
      }
    ],
    "sessionEnd": [
      {
        "command": ".cursor/hooks/efficiency-session-end.mjs",
        "failClosed": false
      }
    ]
  }
}
