# Copy to services/ib-gateway/.env — never commit .env (gitignored).
# Separate live + paper containers — no shared-display 2FA race.

EXISTING_SESSION_DETECTED_ACTION=primary
READ_ONLY_API=no
TWS_ACCEPT_INCOMING=accept
BYPASS_WARNING=yes

# Gateway schedule (must match jts.ini TimeZone once settings volumes exist).
# Soft restart keeps the session on weekdays; cold restart on Sundays requires 2FA.
TIME_ZONE=America/New_York
TZ=America/New_York
AUTO_RESTART_TIME="11:45 PM"
AUTO_LOGOFF_TIME=
# Sunday cold restart (local TIME_ZONE), after 01:00 US/Eastern — pick a 2FA-friendly hour.
TWS_COLD_RESTART=08:00

# 2FA: restart + relogin until IBKR Mobile approves; persisted settings skip repeat 2FA.
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
TWOFA_EXIT_INTERVAL=300
# TWOFA_DEVICE=IBKR Mobile

# Live account (ib-gateway-live → host API 4001, VNC 5901)
TWS_USERID=your-ib-username
TWS_PASSWORD=your-ib-password

# Paper account (ib-gateway-paper → host API 4002, VNC 5902)
TWS_USERID_PAPER=your-ib-username
TWS_PASSWORD_PAPER=your-ib-paper-password

# VNC for 2FA / login UI (live: localhost:5901, paper: localhost:5902)
VNC_SERVER_PASSWORD=replace-with-a-local-vnc-password

# tws-sidecar (Compose service — host DNS/ports set in docker-compose.yml)
# Required: same secret as .env.local and production.env when apps use authenticated routes.
# Stop host `npm run tws:sidecar` before `npm run ib:gateway:up` if port 8765 is busy.
TWS_SIDECAR_SECRET=replace-with-a-local-sidecar-secret
