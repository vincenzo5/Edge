<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.edge.local-prod</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@DEV_ROOT@/scripts/local-prod-service.sh</string>
    <string>run</string>
  </array>

  <key>WorkingDirectory</key>
  <string>@DEV_ROOT@</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>@DEV_ROOT@/.edge/local-prod/launchd-stdout.log</string>
  <key>StandardErrorPath</key>
  <string>@DEV_ROOT@/.edge/local-prod/launchd-stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@PATH@</string>
    <key>HOME</key>
    <string>@HOME@</string>
  </dict>
</dict>
</plist>
